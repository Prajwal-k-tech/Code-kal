{
  "name": "zeroklue-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Prototype student verification using browser-generated zero-knowledge proof material and a Solidity registry.",
  "scripts": {
    "dev": "cd zeroklue-app && node .yarn/releases/yarn-3.2.3.cjs start",
    "start": "cd zeroklue-app && node .yarn/releases/yarn-3.2.3.cjs workspace @se-2/nextjs serve",
    "build": "cd zeroklue-app && node .yarn/releases/yarn-3.2.3.cjs next:build",
    "lint": "cd zeroklue-app && node .yarn/releases/yarn-3.2.3.cjs next:lint",
    "typecheck": "cd zeroklue-app && node .yarn/releases/yarn-3.2.3.cjs next:check-types",
    "contracts:test": "cd zeroklue-app && node .yarn/releases/yarn-3.2.3.cjs foundry:test"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}
